# Compiled class file
*.class

# Log file
*.log

# Maven build output
target/

# Spring Boot migration artifacts: log files under the migration docs are
# deliverables and must be tracked despite the *.log rule above.
!docs/spring-boot-migration/**/*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
